# Production on the Windows desktop (see DEPLOY.md). Fill the blank values.
# For local development with docker-compose.yml, use the "Local development" block at the end.

# LLM: Ollama on the same machine
LLM_PROVIDER="ollama"
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:14b"
ALLOWED_MODELS="ollama:qwen3:14b"

# Embeddings (run inside the API; must be the same model used by the seed)
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"

# Neo4j Aura: copy the values from the credentials file downloaded from console.neo4j.io
NEO4J_URI=""
NEO4J_USER=""
NEO4J_PASSWORD=""
NEO4J_DATABASE=""

# Hosted Postgres (Neon): connection string with ?sslmode=require
DATABASE_URL=""

# HTTP: only the Cloudflare tunnel reaches the API
API_HOST="127.0.0.1"
API_PORT="3333"
TRUST_PROXY_HOPS="1"
# Front-end origins, comma separated (e.g. https://my-profile-rag.vercel.app)
CORS_ORIGIN=""

# Cloudflare Turnstile: secret from the widget in the Cloudflare dashboard (Turnstile → widget → Settings).
# Hostnames are the front-end domains the widget runs on, comma separated, without localhost.
# Leave both blank to disable the check (local development).
TURNSTILE_SECRET=""
TURNSTILE_HOSTNAMES=""

# Cloudflare Access service token, only when Ollama runs on another machine behind a tunnel
#OLLAMA_CF_CLIENT_ID=""
#OLLAMA_CF_CLIENT_SECRET=""

# OpenRouter (disabled for now; required only when LLM_PROVIDER="openrouter")
#OPENROUTER_API_KEY=""
#NLP_MODEL="z-ai/glm-5.3-flash"
#OPENROUTER_SITE_NAME=""
#OPENROUTER_SITE_URL=""

# Local development (npm run infra:up): replace the Neo4j, Postgres and CORS values above with
#NEO4J_URI="bolt://localhost:7688"
#NEO4J_USER="neo4j"
#NEO4J_PASSWORD="password"
#NEO4J_DATABASE="neo4j"
#POSTGRES_USER="my_rag_folio"
#POSTGRES_PASSWORD="my_rag_folio"
#POSTGRES_DB="my_rag_folio_db"
#POSTGRES_PORT="5434"
#DATABASE_URL="postgresql://my_rag_folio:my_rag_folio@localhost:5434/my_rag_folio_db"
#CORS_ORIGIN="*"
#TRUST_PROXY_HOPS="0"

# GitHub user the GitHub tools read from (public API, no auth)
GITHUB_USER="opedro-monteiro"
