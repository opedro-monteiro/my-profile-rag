# LLM: ollama (default) or openrouter
LLM_PROVIDER="ollama"

# Ollama
OLLAMA_MODEL="glm-4.7-flash:latest"
OLLAMA_URL="http://localhost:11434"

# OpenRouter (required only when LLM_PROVIDER="openrouter")
#OPENROUTER_API_KEY=""
#NLP_MODEL="z-ai/glm-5.3-flash"
#OPENROUTER_SITE_NAME=""
#OPENROUTER_SITE_URL=""

# Embeddings
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"

# Neo4j (port published by docker-compose.yml)
NEO4J_URI="bolt://localhost:7688"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""

# Postgres (usage stats). Matches the postgres service in docker-compose.yml
POSTGRES_USER="my_rag_folio"
POSTGRES_PASSWORD="my_rag_folio"
POSTGRES_DB="my_rag_folio_db"
POSTGRES_PORT="5434"
DATABASE_URL="postgresql://my_rag_folio:my_rag_folio@localhost:5434/my_rag_folio_db"

# API. API_HOST defaults to 0.0.0.0 for hosted deploys; keep it local here.
# PORT, when set by the platform, takes precedence over API_PORT.
API_HOST="127.0.0.1"
#API_PORT="3333"
#CORS_ORIGIN="*"
