  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@huggingface/transformers": "^4.3.2",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/neo4j": "^0.1.29",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.0",
    "@langchain/textsplitters": "^1.0.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "langchain": "^1.6.0",
    "neo4j-driver": "^6.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
