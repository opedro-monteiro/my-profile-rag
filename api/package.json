{
  "name": "my-profile-rag",
  "version": "1.0.0",
  "description": "",
  "main": "src/cli/chat.ts",
  "scripts": {
    "chat": "node --no-warnings --env-file .env src/cli/chat.ts",
    "api": "node --no-warnings --env-file .env src/cli/api.ts",
    "seed": "node --no-warnings --env-file .env src/cli/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "infra:up": "docker compose up -d --wait && npm run db:migrate",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down --volumes",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "type": "module",
  "keywords": [],
