# LLM: ollama (default) or openrouter
LLM_PROVIDER="ollama"

# Ollama
OLLAMA_MODEL="glm-4.7-flash:latest"
OLLAMA_URL="http://localhost:11434"

# OpenRouter (required only when LLM_PROVIDER="openrouter")
#OPENROUTER_API_KEY=""
#NLP_MODEL="z-ai/glm-5.3-flash"
#OPENROUTER_SITE_NAME=""
#OPENROUTER_SITE_URL=""

# Embeddings
EMBEDDING_MODEL="Xenova/all-MiniLM-L6-v2"

# Neo4j (port published by docker-compose.yml)
NEO4J_URI="bolt://localhost:7688"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""
